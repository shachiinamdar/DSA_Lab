#include <stdio.h>

int main()
{
    char s1[100], s2[100], temp[100];
    int ch, i, start, len, flag;

    printf("Enter first string: ");
    scanf("%s", s1);

    printf("Enter second string: ");
    scanf("%s", s2);

    printf("\n1. Substring\n2. Palindrome\n3. Compare\n4. Copy\n5. Reverse\n");
    printf("Enter your choice: ");
    scanf("%d", &ch);

    switch(ch)
    {
        case 1:
            printf("Enter start index and length: ");
            scanf("%d%d", &start, &len);

            printf("Substring: ");

            for(i = start; i < start + len && s1[i] != '\0'; i++)
                printf("%c", s1[i]);

            break;


        case 2:
            len = 0;
            flag = 1;

            while(s1[len] != '\0')
                len++;

            for(i = 0; i < len / 2; i++)
            {
                if(s1[i] != s1[len - 1 - i])
                {
                    flag = 0;
                    break;
                }
            }

            if(flag)
                printf("Palindrome");
            else
                printf("Not Palindrome");

            break;


        case 3:
            i = 0;
            flag = 1;

            while(s1[i] != '\0' || s2[i] != '\0')
            {
                if(s1[i] != s2[i])
                {
                    flag = 0;
                    break;
                }

                i++;
            }

            if(flag)
                printf("Strings are Equal");
            else
                printf("Strings are Not Equal");

            break;


        case 4:
            i = 0;
            while(s1[i] != '\0')
            {
                temp[i] = s1[i];
                i++;
            }

            temp[i] = '\0';

            printf("Copied String: %s", temp);

            break;


        case 5:
            len = 0;
            while(s1[len] != '\0')
                len++;

            printf("Reversed String: ");

            for(i = len - 1; i >= 0; i--)
                printf("%c", s1[i]);

            break;


        default:
            printf("Invalid choice");
    }

    return 0;
}
