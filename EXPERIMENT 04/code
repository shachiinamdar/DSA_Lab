#include <stdio.h>

typedef struct student {
    int roll;
    char name[50];
    float sgpa;
} student;

void create(student st[100], int n);
void display(student st[100], int n);

int main() {
    student s[100];
    int n;

    printf("No of students: ");
    scanf("%d", &n);

    create(s, n);
    display(s, n);

    return 0;
}

void create(student st[100], int n) {
    for (int i = 0; i < n; i++) {
        printf("\nEnter Roll, Name, and SGPA for student %d:\n", i + 1);
        scanf("%d %s %f", &st[i].roll, st[i].name, &st[i].sgpa);
    }
}

void display(student st[100], int n) {
    printf("\nStudent Data\n");
    for (int i = 0; i < n; i++) {
        printf("Roll:%d Name:%s SGPA:%.2f\n", st[i].roll, st[i].name, st[i].sgpa);
    }
}
